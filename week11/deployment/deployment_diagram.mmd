%% Deployment Diagram — Week 11
%% Shows where each component runs.
%% Render at: https://mermaid.live

graph TD
    subgraph User ["👤 User's Browser"]
        Browser[Web Browser]
    end

    subgraph Cloud ["☁️ Streamlit Cloud (or local)"]
        App["🖥️ Streamlit App<br/>(app.py)"]
        Env[".env secrets"]
    end

    subgraph External ["🌐 External APIs"]
        Claude["Anthropic Claude API"]
        Gemini["Google Gemini API"]
    end

    subgraph Local ["💻 Local (optional)"]
        Ollama["Ollama<br/>localhost:11434"]
    end

    Browser -->|HTTPS| App
    App --> Claude
    App --> Gemini
    App -.->|local only| Ollama
    Env -.->|secrets| App
